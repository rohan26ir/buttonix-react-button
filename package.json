{
  "name": "buttonix",
  "version": "2.0.0",
  "description": "22 beautiful animated React button variants — solid, outline, ghost, soft, gradient, glassmorphism, shimmer, border-beam, glow, neumorphic, neon, aurora, 3D-press, ripple, bounce, jelly, slide-fill, underline-reveal, split-reveal, magnetic, and more. Zero runtime beyond React. Built with Tailwind CSS v4, CVA, and strict TypeScript.",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "dist/style.css"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "react-component",
    "button",
    "animated-button",
    "tailwind",
    "tailwindcss",
    "animation",
    "shimmer",
    "ripple",
    "glassmorphism",
    "neumorphic",
    "gradient",
    "ui-component",
    "typescript",
    "cva",
    "class-variance-authority",
    "accessible",
    "aria",
    "frontend",
    "ui",
    "ux",
    "modern-ui",
    "react-button",
    "customizable-button",
    "neon",
    "aurora",
    "3d-press",
    "border-beam",
    "glow"
  ],
  "author": {
    "name": "Mahedul Islam Rohan",
    "email": "rohan26ir@gmail.com",
    "url": "https://github.com/rohan26ir"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohan26ir/buttonix-react-button.git"
  },
  "homepage": "https://stackminds.netlify.app/npm/buttonix",
  "bugs": {
    "url": "https://github.com/rohan26ir/buttonix-react-button/issues",
    "email": "rohan26ir@gmail.com"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
